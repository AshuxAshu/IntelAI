<mujoco model="dinner_table">
  <compiler angle="radian" meshdir="../assets/meshes" texturedir="../assets/textures"/>
  <option timestep="0.002" integrator="implicitfast" iterations="50"/>

  <default>
    <geom solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <default class="furniture">
      <geom friction="0.8 0.005 0.0001" rgba="0.75 0.7 0.65 1"/>
    </default>
    <!-- SO-101 arm default classes (so101/sts3215/...) are merged at build time -->
  </default>

  <asset>
    <!-- Textures and materials -->
    <texture name="table_tex" type="2d" file="table/table_01.png"/>
    <material name="table_mat" texture="table_tex" specular="0.2" shininess="0.1"/>

    <texture name="floor_tex" type="2d" file="floor/floor_01.png"/>
    <material name="floor_mat" texture="floor_tex" specular="0.1" shininess="0.1"/>

    <texture name="wall_tex" type="2d" file="wall/wall_01.png"/>
    <material name="wall_mat" texture="wall_tex" specular="0.05" shininess="0.05"/>

    <texture name="placemat_tex" type="2d" file="placemat/placemat_01.png"/>
    <material name="placemat_mat" texture="placemat_tex" specular="0.1" shininess="0.1"/>
    <!-- SO-101 arm meshes are merged at build time from assets/meshes/so101/official -->
  </asset>

  <worldbody>
    <include file="parts/lights.xml"/>
    <include file="parts/table.xml"/>
    <include file="parts/drawer_cabinet.xml"/>
    <include file="parts/placemats.xml"/>
    <include file="parts/decor.xml"/>
  </worldbody>
</mujoco>
